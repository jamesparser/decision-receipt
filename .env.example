# Model for Bull/Bear/Judge agents — you bring your own
# Examples: openrouter, anthropic, openai-compatible, local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Demo / practice-trade state (local only — never trades)
DECISION_RECEIPT_OUT_DIR=./out
